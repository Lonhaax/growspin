generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  username           String              @unique
  passwordHash       String
  role               String              @default("user")
  mockBalance        Int                 @default(1000)
  level              Int                 @default(1)
  xp                 Int                 @default(0)
  rakebackBalance    Int                 @default(0)
  totalWagered       Int                 @default(0)
  lastFaucetClaim    DateTime?
  createdAt          DateTime            @default(now())
  debt               Int                 @default(0)
  debtCreatedAt      DateTime?
  isFrozen           Boolean             @default(false)
  affiliateCode      String?             @unique
  affiliateEarnings  Int                 @default(0)
  referredBy         String?
  isChatBanned       Boolean             @default(false)
  lastIp             String?
  chatMessages       ChatMessage[]
  cryptoInvoices     CryptoInvoice[]
  dailyClaims        DailyClaim[]
  depositIntents     DepositIntent[]
  minesGames         MinesGame[]
  provablyFair       ProvablyFair[]
  refreshTokens      RefreshToken[]
  transactions       Transaction[]
  inventory          UserItem[]
  withdrawalRequests WithdrawalRequest[]
}

model ChatFilter {
  id        Int      @id @default(autoincrement())
  word      String   @unique
  createdAt DateTime @default(now())
}

model Transaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int
  gameType  String
  result    String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "Transaction_userId_fkey")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "RefreshToken_userId_fkey")
}

model Battle {
  id                Int                 @id @default(autoincrement())
  caseIds           String              @db.Text
  mode              String              @default("normal")
  entryFee          Int
  status            String              @default("waiting")
  winnerId          String?
  totalPotValue     Int                 @default(0)
  createdAt         DateTime            @default(now())
  targetPlayerCount Int                 @default(2)
  format            String              @default("1v1")
  participants      BattleParticipant[]
}

model BattleParticipant {
  id        Int    @id @default(autoincrement())
  battleId  Int
  userId    String
  lootTotal Int    @default(0)
  position  Int
  battle    Battle @relation(fields: [battleId], references: [id])

  @@index([battleId], map: "BattleParticipant_battleId_fkey")
}

model JackpotRound {
  id            Int            @id @default(autoincrement())
  status        String         @default("waiting")
  totalPotValue Int            @default(0)
  winnerId      String?
  winningTicket Int?
  createdAt     DateTime       @default(now())
  finishedAt    DateTime?
  entries       JackpotEntry[]
}

model JackpotEntry {
  id        Int          @id @default(autoincrement())
  roundId   Int
  userId    String
  amount    Int
  ticketMin Int
  ticketMax Int
  round     JackpotRound @relation(fields: [roundId], references: [id])

  @@index([roundId], map: "JackpotEntry_roundId_fkey")
}

model UserItem {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  value       Int
  color       String
  imageUrl    String?  @db.Text
  status      String   @default("inventory")
  createdAt   DateTime @default(now())
  isBorrowed  Boolean  @default(false)
  borrowPrice Int      @default(0)
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "UserItem_userId_fkey")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  content   String   @db.Text
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "ChatMessage_userId_fkey")
}

model ProvablyFair {
  id         Int      @id @default(autoincrement())
  userId     Int
  serverSeed String   @db.Text
  serverHash String
  clientSeed String   @db.Text
  nonce      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "ProvablyFair_userId_fkey")
}

model MinesGame {
  id            Int      @id @default(autoincrement())
  userId        Int
  betAmount     Int
  minesCount    Int
  boardState    String   @db.Text
  mineLocations String   @db.Text
  status        String   @default("playing")
  multiplier    Float    @default(1)
  profit        Int      @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "MinesGame_userId_fkey")
}

model Case {
  id        Int        @id @default(autoincrement())
  name      String
  price     Int
  image     String?    @db.Text
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  type      String     @default("normal")
  items     CaseItem[]
}

model CaseItem {
  id              Int     @id @default(autoincrement())
  caseId          Int
  name            String
  value           Int
  color           String
  weight          Float
  image           String? @db.Text
  imageUrl        String? @db.Text
  isLuckyStarItem Boolean @default(false)
  case            Case    @relation(fields: [caseId], references: [id])

  @@index([caseId], map: "CaseItem_caseId_fkey")
}

model SiteSettings {
  id                    Int      @id @default(1)
  maintenanceMode       Boolean  @default(false)
  mockBalanceOnRegister Int      @default(100000)
  coinflipHouseEdge     Float    @default(0.05)
  rouletteHouseEdge     Float    @default(0.05)
  minesHouseEdge        Float    @default(0.05)
  coinflipEnabled       Boolean  @default(true)
  rouletteEnabled       Boolean  @default(true)
  minesEnabled          Boolean  @default(true)
  updatedAt             DateTime @updatedAt
  maxBorrowLimit        Int      @default(100000)
  borrowEnabled         Boolean  @default(true)
  slotsEnabled          Boolean  @default(true)
  slotsHouseEdge        Float    @default(0.05)
  casinoPot             Int      @default(0)
  xpBase                Int      @default(1000)
}

model DailyClaim {
  id          Int      @id @default(autoincrement())
  userId      Int
  tier        String
  claimedAt   DateTime @default(now())
  rewardName  String
  rewardValue Int
  rewardColor String
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, tier])
}

model DepositIntent {
  id        Int      @id @default(autoincrement())
  userId    Int
  growId    String
  worldName String
  botName   String
  status    String   @default("PENDING")
  amount    Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "DepositIntent_userId_fkey")
}

model CryptoInvoice {
  id          Int      @id @default(autoincrement())
  userId      Int
  paymentId   String   @unique
  status      String   @default("waiting")
  payAmount   Float
  payCurrency String
  dlsCredited Int
  createdAt   DateTime @default(now())
  address     String?  @db.Text
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "CryptoInvoice_userId_fkey")
}

model AdminItem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  value     Int
  color     String   @default("#ffffff")
  imageUrl  String   @db.Text
  createdAt DateTime @default(now())
}

model WithdrawalRequest {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int
  method    String   @default("crypto")
  address   String   @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "WithdrawalRequest_userId_fkey")
}
